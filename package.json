{
  "name": "solid-checkin-albert",
  "version": "1.0.0",
  "private": true,
  "description": "Exemplos de SOLID em TypeScript usando um check-in simplificado como domínio",
  "type": "module",
  "scripts": {
    "srp:antes": "tsx src/01-srp/antes/index.ts",
    "srp:depois": "tsx src/01-srp/depois/index.ts",
    "ocp:antes": "tsx src/02-ocp/antes/index.ts",
    "ocp:depois": "tsx src/02-ocp/depois/index.ts",
    "lsp:antes": "tsx src/03-lsp/antes/index.ts",
    "lsp:depois": "tsx src/03-lsp/depois/index.ts",
    "isp:antes": "tsx src/04-isp/antes/index.ts",
    "isp:depois": "tsx src/04-isp/depois/index.ts",
    "dip:antes": "tsx src/05-dip/antes/index.ts",
    "dip:depois": "tsx src/05-dip/depois/index.ts",
    "tudo-junto:antes": "tsx src/06-tudo-junto/antes/index.ts",
    "tudo-junto:depois": "tsx src/06-tudo-junto/depois/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:nomes": "node scripts/check-nomes.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "exemplos": "node scripts/rodar-exemplos.mjs",
    "check": "npm run typecheck && npm run lint && npm run lint:nomes && npm run format:check && npm run exemplos"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": ">=20"
  }
}
